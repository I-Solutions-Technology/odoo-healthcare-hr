<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="allowance_result_view_list" model="ir.ui.view">
        <field name="name">healthcare.allowance.result.list</field>
        <field name="model">healthcare.allowance.result</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'cancelled'" decoration-success="state == 'processed'">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"/>
                    <button name="action_draft" type="object" string="Reset to Draft"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="rule_id"/>
                <field name="type_id" optional="hide"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="department_id" optional="show"/>
                <field name="branch_id" optional="hide"/>
                <field name="quantity"/>
                <field name="rate" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="taxable" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'processed'"/>
            </list>
        </field>
    </record>
    <record id="allowance_result_view_form" model="ir.ui.view">
        <field name="name">healthcare.allowance.result.form</field>
        <field name="model">healthcare.allowance.result</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('confirmed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('processed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,processed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                            <field name="type_id"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="quantity" readonly="1"/>
                            <field name="rate" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="computation_note" readonly="1"/>
                            <field name="taxable"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shifts" name="shifts">
                            <field name="assignment_ids" readonly="1"/>
                        </page>
                        <page string="On-call" name="oncall">
                            <field name="oncall_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="allowance_result_view_pivot" model="ir.ui.view">
        <field name="name">healthcare.allowance.result.pivot</field>
        <field name="model">healthcare.allowance.result</field>
        <field name="arch" type="xml">
            <pivot string="Allowance Analysis" sample="1">
                <field name="department_id" type="row"/>
                <field name="type_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="allowance_result_view_graph" model="ir.ui.view">
        <field name="name">healthcare.allowance.result.graph</field>
        <field name="model">healthcare.allowance.result</field>
        <field name="arch" type="xml">
            <graph string="Allowances" type="bar" stacked="1" sample="1">
                <field name="date_from" interval="month"/>
                <field name="type_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="allowance_result_view_search" model="ir.ui.view">
        <field name="name">healthcare.allowance.result.search</field>
        <field name="model">healthcare.allowance.result</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="rule_id"/>
                <field name="type_id"/>
                <field name="department_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="processed" string="In Payroll" domain="[('state', '=', 'processed')]"/>
                <separator/>
                <filter name="date_from" string="Period" date="date_from"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_allowance_result" model="ir.actions.act_window">
        <field name="name">Allowance Results</field>
        <field name="res_model">healthcare.allowance.result</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>
    <record id="action_allowance_analysis" model="ir.actions.act_window">
        <field name="name">Allowance Analysis</field>
        <field name="res_model">healthcare.allowance.result</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
    </record>
</odoo>
