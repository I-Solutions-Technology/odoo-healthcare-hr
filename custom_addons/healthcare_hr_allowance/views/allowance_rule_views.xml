<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="allowance_rule_view_list" model="ir.ui.view">
        <field name="name">healthcare.allowance.rule.list</field>
        <field name="model">healthcare.allowance.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_id"/>
                <field name="calculation_method"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="percentage" optional="show"/>
                <field name="employee_category" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="branch_id" optional="hide"/>
                <field name="effective_from" optional="hide"/>
                <field name="effective_to" optional="hide"/>
                <field name="taxable" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="allowance_rule_view_form" model="ir.ui.view">
        <field name="name">healthcare.allowance.rule.form</field>
        <field name="model">healthcare.allowance.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. ICU night allowance"/></h1></div>
                    <group>
                        <group string="Calculation">
                            <field name="type_id"/>
                            <field name="calculation_method"/>
                            <field name="hour_basis" invisible="calculation_method != 'per_hour'" required="calculation_method == 'per_hour'"/>
                            <field name="shift_basis" invisible="calculation_method != 'per_shift'" required="calculation_method == 'per_shift'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" invisible="calculation_method not in ('fixed', 'per_shift', 'per_hour')"/>
                            <field name="percentage" invisible="calculation_method not in ('percentage_basic', 'percentage_gross')"/>
                            <field name="minimum"/>
                            <field name="maximum"/>
                            <field name="sequence"/>
                            <field name="taxable"/>
                        </group>
                        <group string="Applies To">
                            <field name="effective_from"/>
                            <field name="effective_to"/>
                            <field name="employee_category"/>
                            <field name="job_id"/>
                            <field name="contract_type_id"/>
                            <field name="branch_id"/>
                            <field name="department_id"/>
                            <field name="unit_id"/>
                            <field name="shift_type" invisible="calculation_method not in ('per_shift', 'per_hour')"/>
                            <field name="shift_template_ids" widget="many2many_tags" invisible="calculation_method not in ('per_shift', 'per_hour')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Formula" invisible="calculation_method != 'formula'">
                        <field name="formula" widget="code" options="{'mode': 'python'}" nolabel="1" colspan="2"
                               placeholder="result = hours['night_hours'] * 30 if shifts['night'] &gt;= 4 else 0"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_allowance_rule" model="ir.actions.act_window">
        <field name="name">Allowance Rules</field>
        <field name="res_model">healthcare.allowance.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
