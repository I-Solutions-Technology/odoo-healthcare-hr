<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="allowance_type_view_list" model="ir.ui.view">
        <field name="name">healthcare.allowance.type.list</field>
        <field name="model">healthcare.allowance.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="taxable"/>
            </list>
        </field>
    </record>
    <record id="action_allowance_type" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="res_model">healthcare.allowance.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
