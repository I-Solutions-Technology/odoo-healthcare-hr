<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="allowance_compute_wizard_view_form" model="ir.ui.view">
        <field name="name">healthcare.allowance.compute.wizard.form</field>
        <field name="model">healthcare.allowance.compute.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="confirm"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <p class="text-muted">Only approved shifts and on-call duties are used. Running the computation again updates the same results.</p>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_allowance_compute_wizard" model="ir.actions.act_window">
        <field name="name">Compute Allowances</field>
        <field name="res_model">healthcare.allowance.compute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
