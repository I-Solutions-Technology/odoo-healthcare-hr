<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_kpi_template_company" model="ir.rule">
        <field name="name">KPI template: multi-company</field>
        <field name="model_id" ref="model_healthcare_appraisal_kpi_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_kpi_line_company" model="ir.rule">
        <field name="name">Appraisal KPI: multi-company</field>
        <field name="model_id" ref="model_healthcare_appraisal_kpi_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <!-- Same visibility as the standard appraisal: own, appraiser, or subordinates -->
    <record id="rule_kpi_line_employee" model="ir.rule">
        <field name="name">Appraisal KPI: own, appraised or subordinate appraisals</field>
        <field name="model_id" ref="model_healthcare_appraisal_kpi_line"/>
        <field name="domain_force">['|', '|',
            ('appraisal_id.employee_id.user_id', '=', user.id),
            ('appraisal_id.manager_ids', 'in', user.employee_ids.ids),
            ('appraisal_id.employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_kpi_line_appraisal_officer" model="ir.rule">
        <field name="name">Appraisal KPI: appraisal officers</field>
        <field name="model_id" ref="model_healthcare_appraisal_kpi_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_appraisal.group_hr_appraisal_user'))]"/>
    </record>
</data>
</odoo>
