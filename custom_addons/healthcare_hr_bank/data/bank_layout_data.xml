<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_bank_batch" model="ir.sequence">
        <field name="name">Payroll Bank Batch</field>
        <field name="code">healthcare.payroll.bank.batch</field>
        <field name="prefix">SAL/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="layout_generic_csv" model="healthcare.payroll.bank.layout">
        <field name="name">Generic CSV</field>
        <field name="file_format">csv</field>
        <field name="encoding">utf-8-sig</field>
        <field name="column_ids" eval="[
            (0, 0, {'sequence': 1, 'header': 'Employee No', 'field': 'employee_number'}),
            (0, 0, {'sequence': 2, 'header': 'Name', 'field': 'employee_name'}),
            (0, 0, {'sequence': 3, 'header': 'Bank', 'field': 'bank_name'}),
            (0, 0, {'sequence': 4, 'header': 'IBAN', 'field': 'iban'}),
            (0, 0, {'sequence': 5, 'header': 'Account', 'field': 'account_number'}),
            (0, 0, {'sequence': 6, 'header': 'Amount', 'field': 'amount'}),
            (0, 0, {'sequence': 7, 'header': 'Currency', 'field': 'currency'}),
            (0, 0, {'sequence': 8, 'header': 'Reference', 'field': 'reference'}),
        ]"/>
    </record>
    <record id="layout_generic_xlsx" model="healthcare.payroll.bank.layout">
        <field name="name">Generic Excel</field>
        <field name="file_format">xlsx</field>
        <field name="column_ids" eval="[
            (0, 0, {'sequence': 1, 'header': 'Employee No', 'field': 'employee_number'}),
            (0, 0, {'sequence': 2, 'header': 'Name', 'field': 'employee_name'}),
            (0, 0, {'sequence': 3, 'header': 'Arabic Name', 'field': 'arabic_name'}),
            (0, 0, {'sequence': 4, 'header': 'Bank', 'field': 'bank_name'}),
            (0, 0, {'sequence': 5, 'header': 'IBAN', 'field': 'iban'}),
            (0, 0, {'sequence': 6, 'header': 'Amount', 'field': 'amount'}),
            (0, 0, {'sequence': 7, 'header': 'Payment Date', 'field': 'payment_date'}),
        ]"/>
    </record>
    <record id="layout_fixed_txt" model="healthcare.payroll.bank.layout">
        <field name="name">Fixed-width TXT (example)</field>
        <field name="file_format">txt</field>
        <field name="include_header" eval="False"/>
        <field name="amount_without_separator" eval="True"/>
        <field name="date_format">%Y%m%d</field>
        <field name="column_ids" eval="[
            (0, 0, {'sequence': 1, 'header': 'Record', 'field': 'constant', 'constant_value': 'D', 'width': 1}),
            (0, 0, {'sequence': 2, 'header': 'IBAN', 'field': 'iban', 'width': 34}),
            (0, 0, {'sequence': 3, 'header': 'Amount', 'field': 'amount', 'width': 15, 'alignment': 'right', 'pad_char': '0'}),
            (0, 0, {'sequence': 4, 'header': 'Name', 'field': 'employee_name', 'width': 35}),
            (0, 0, {'sequence': 5, 'header': 'Date', 'field': 'payment_date', 'width': 8}),
            (0, 0, {'sequence': 6, 'header': 'Reference', 'field': 'reference', 'width': 20}),
        ]"/>
    </record>
</odoo>
