<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_bank_batch_company" model="ir.rule">
        <field name="name">Bank batch: multi-company</field>
        <field name="model_id" ref="model_healthcare_payroll_bank_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bank_line_company" model="ir.rule">
        <field name="name">Bank line: multi-company</field>
        <field name="model_id" ref="model_healthcare_payroll_bank_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bank_layout_company" model="ir.rule">
        <field name="name">Bank layout: multi-company</field>
        <field name="model_id" ref="model_healthcare_payroll_bank_layout"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
</data>
</odoo>
