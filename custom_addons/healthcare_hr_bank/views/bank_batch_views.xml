<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bank_batch_view_list" model="ir.ui.view">
        <field name="name">healthcare.payroll.bank.batch.list</field>
        <field name="model">healthcare.payroll.bank.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="layout_id"/>
                <field name="branch_id" optional="show"/>
                <field name="line_count" string="Lines"/>
                <field name="error_count" string="Errors" decoration-danger="error_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state in ('generated', 'exported')" decoration-success="state in ('sent', 'done')"/>
            </list>
        </field>
    </record>
    <record id="bank_batch_view_form" model="ir.ui.view">
        <field name="name">healthcare.payroll.bank.batch.form</field>
        <field name="model">healthcare.payroll.bank.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" type="object" string="Load Payslips" class="btn-primary" invisible="state not in ('draft', 'generated')"/>
                    <button name="action_export" type="object" string="Export File" class="btn-primary" invisible="state != 'generated'"/>
                    <button name="action_send_to_bank" type="object" string="Send via API" invisible="state != 'exported'"/>
                    <button name="action_mark_sent" type="object" string="Mark as Sent" invisible="state != 'exported'"/>
                    <button name="action_done" type="object" string="Confirm Payment" class="btn-primary" invisible="state != 'sent'"
                            groups="healthcare_hr_core.group_hc_payroll_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('generated', 'exported', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,exported,sent,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="not error_count">
                        <field name="error_count" nolabel="1"/> employee(s) cannot be paid by transfer: fix their bank account or delete the line.
                    </div>
                    <group>
                        <group>
                            <field name="layout_id" readonly="state not in ('draft', 'generated')"/>
                            <field name="payment_date" readonly="state not in ('draft', 'generated')"/>
                            <field name="reference" readonly="state not in ('draft', 'generated')"/>
                            <field name="export_file" filename="export_filename" invisible="not export_file"/>
                            <field name="export_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="payslip_run_id" readonly="state != 'draft'"/>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="branch_id" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft', 'generated')">
                        <list create="0" decoration-danger="state == 'error'">
                            <field name="employee_id"/>
                            <field name="payslip_id" optional="hide"/>
                            <field name="bank_id"/>
                            <field name="iban"/>
                            <field name="account_number" optional="hide"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount" sum="Total"/>
                            <field name="reference" optional="show"/>
                            <field name="state"/>
                            <field name="error_message"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_bank_batch" model="ir.actions.act_window">
        <field name="name">Bank Batches</field>
        <field name="res_model">healthcare.payroll.bank.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
