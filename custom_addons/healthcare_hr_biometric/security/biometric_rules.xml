<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_device_company" model="ir.rule">
        <field name="name">Biometric device: multi-company</field>
        <field name="model_id" ref="model_healthcare_biometric_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_device_branch" model="ir.rule">
        <field name="name">Biometric device: allowed branches</field>
        <field name="model_id" ref="model_healthcare_biometric_device"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_user'))]"/>
    </record>
    <record id="rule_device_all" model="ir.rule">
        <field name="name">Biometric device: all branches (HR manager / director)</field>
        <field name="model_id" ref="model_healthcare_biometric_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_manager')), (4, ref('healthcare_hr_core.group_hc_director'))]"/>
    </record>
