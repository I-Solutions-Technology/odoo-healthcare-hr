<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biometric_mapping_view_list" model="ir.ui.view">
        <field name="name">healthcare.biometric.employee.mapping.list</field>
        <field name="model">healthcare.biometric.employee.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="device_employee_code"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="device_id" placeholder="All devices"/>
                <field name="branch_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="biometric_mapping_view_search" model="ir.ui.view">
        <field name="name">healthcare.biometric.employee.mapping.search</field>
        <field name="model">healthcare.biometric.employee.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="device_employee_code"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <filter name="company_wide" string="All devices" domain="[('device_id', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_device" string="Device" context="{'group_by': 'device_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_biometric_mapping" model="ir.actions.act_window">
        <field name="name">Employee Mapping</field>
        <field name="res_model">healthcare.biometric.employee.mapping</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Map device employee codes to employees</p>
            <p>A mapping without device applies to every device of the company; a device-specific mapping wins.</p>
        </field>
    </record>
</odoo>
