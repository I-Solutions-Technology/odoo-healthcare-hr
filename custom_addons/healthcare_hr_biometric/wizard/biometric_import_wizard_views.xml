<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biometric_import_wizard_view_form" model="ir.ui.view">
        <field name="name">healthcare.biometric.import.wizard.form</field>
        <field name="model">healthcare.biometric.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="device_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="delimiter"/>
                    <field name="process_now"/>
                </group>
                <div class="text-muted">
                    Columns: <code>employee_code,timestamp,event_type</code>. Timestamps (e.g. 2026-01-31 08:00:00)
                    are in the device timezone; event_type is check_in, check_out or unknown. Rows already imported
                    are skipped, invalid rows are kept as error logs.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_biometric_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Punches</field>
        <field name="res_model">healthcare.biometric.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
