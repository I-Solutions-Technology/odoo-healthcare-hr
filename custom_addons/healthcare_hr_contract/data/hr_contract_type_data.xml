        <field name="sequence">27</field>
    </record>
    <record id="contract_type_outsourced" model="hr.contract.type">
        <field name="name">Outsourced</field>
        <field name="code">Outsourced</field>
        <field name="sequence">28</field>
    </record>
</odoo>
