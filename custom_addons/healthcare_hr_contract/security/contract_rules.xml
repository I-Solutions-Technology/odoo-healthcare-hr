<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_probation_review_company" model="ir.rule">
        <field name="name">Probation review: multi-company</field>
        <field name="model_id" ref="model_healthcare_hr_probation_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_probation_review_dept_manager" model="ir.rule">
        <field name="name">Probation review: department manager sees his departments</field>
        <field name="model_id" ref="model_healthcare_hr_probation_review"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('reviewer_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_department_manager'))]"/>
    </record>
    <record id="rule_probation_review_officer" model="ir.rule">
        <field name="name">Probation review: officer allowed branches</field>
        <field name="model_id" ref="model_healthcare_hr_probation_review"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_officer'))]"/>
    </record>
</data>
</odoo>
