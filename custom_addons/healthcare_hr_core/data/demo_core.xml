<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_hospital_a" model="healthcare.hr.branch">
        <field name="name">Hospital A</field>
        <field name="code">HOSA</field>
        <field name="branch_type">hospital</field>
    </record>
    <record id="demo_branch_1" model="healthcare.hr.branch">
        <field name="name">Branch 1</field>
        <field name="code">HOSA-B1</field>
        <field name="branch_type">branch</field>
        <field name="parent_id" ref="demo_hospital_a"/>
