<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_healthcare_hr" model="ir.module.category">
        <field name="name">Healthcare HR</field>
        <field name="sequence">15</field>
    </record>

    <!-- ===== Healthcare HR (User / Officer / Manager) ===== -->
    <record id="privilege_healthcare_hr" model="res.groups.privilege">
        <field name="name">Healthcare HR</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_self_service" model="res.groups">
        <field name="name">Employee Self Service</field>
        <field name="comment">Own shifts, attendance, credentials, training, loans and exit requests.</field>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_hc_self_service'))]"/>
    </record>
    <record id="group_hc_user" model="res.groups">
        <field name="name">Healthcare HR User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_healthcare_hr"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read access to the healthcare organisation, schedules and compliance data of the allowed branches.</field>
    </record>
    <record id="group_hc_officer" model="res.groups">
        <field name="name">Healthcare HR Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_healthcare_hr"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user')), (4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Manages employees, contracts, credentials, onboarding and exits of the allowed branches.</field>
    </record>
    <record id="group_hc_manager" model="res.groups">
        <field name="name">Healthcare HR Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_healthcare_hr"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_officer')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="comment">All branches, configuration and final approvals.</field>
    </record>

    <!-- ===== Attendance ===== -->
    <record id="privilege_hc_attendance" model="res.groups.privilege">
        <field name="name">Healthcare Attendance</field>
        <field name="sequence">2</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_attendance_officer" model="res.groups">
        <field name="name">Attendance Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hc_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user'))]"/>
    </record>
    <record id="group_hc_attendance_manager" model="res.groups">
        <field name="name">Attendance Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hc_attendance"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_attendance_officer'))]"/>
    </record>

    <!-- ===== Scheduling ===== -->
    <record id="privilege_hc_scheduling" model="res.groups.privilege">
        <field name="name">Workforce Scheduling</field>
        <field name="sequence">3</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_scheduling_officer" model="res.groups">
        <field name="name">Scheduling Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hc_scheduling"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user'))]"/>
    </record>
    <record id="group_hc_scheduling_manager" model="res.groups">
        <field name="name">Scheduling Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hc_scheduling"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_scheduling_officer'))]"/>
    </record>

    <!-- ===== Payroll ===== -->
    <record id="privilege_hc_payroll" model="res.groups.privilege">
        <field name="name">Healthcare Payroll</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_payroll_officer" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hc_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user'))]"/>
        <field name="comment">Salary, allowances, loans, payroll inputs and bank batches.</field>
    </record>
    <record id="group_hc_payroll_manager" model="res.groups">
        <field name="name">Payroll Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hc_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_payroll_officer'))]"/>
    </record>

    <!-- ===== Talent ===== -->
    <record id="privilege_hc_talent" model="res.groups.privilege">
        <field name="name">Healthcare Talent</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_training_officer" model="res.groups">
        <field name="name">Training Officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hc_talent"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user'))]"/>
    </record>
    <record id="group_hc_recruitment_officer" model="res.groups">
        <field name="name">Recruitment Officer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hc_talent"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_training_officer'))]"/>
    </record>

    <!-- ===== Management ===== -->
    <record id="privilege_hc_management" model="res.groups.privilege">
        <field name="name">Healthcare Management</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="module_category_healthcare_hr"/>
    </record>
    <record id="group_hc_department_manager" model="res.groups">
        <field name="name">Department Manager</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hc_management"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_user'))]"/>
        <field name="comment">Sees the employees of the departments they manage and approves their swaps, overtime and clearance items. No payroll access.</field>
    </record>
    <record id="group_hc_director" model="res.groups">
        <field name="name">Hospital Director</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hc_management"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_department_manager'))]"/>
        <field name="comment">Read access across all branches and dashboards.</field>
    </record>
    <record id="group_hc_admin" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_hc_management"/>
        <field name="implied_ids" eval="[(4, ref('group_hc_director')), (4, ref('group_hc_manager')),
                                         (4, ref('group_hc_attendance_manager')), (4, ref('group_hc_scheduling_manager')),
                                         (4, ref('group_hc_payroll_manager')), (4, ref('group_hc_recruitment_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
