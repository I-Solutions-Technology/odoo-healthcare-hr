<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="healthcare_unit_view_list" model="ir.ui.view">
        <field name="name">healthcare.hr.unit.list</field>
        <field name="model">healthcare.hr.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="unit_type"/>
                <field name="manager_id" widget="many2one_avatar_employee" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="healthcare_unit_view_form" model="ir.ui.view">
        <field name="name">healthcare.hr.unit.form</field>
        <field name="model">healthcare.hr.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. ICU - Bay A"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="unit_type"/>
                            <field name="department_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="manager_id" widget="many2one_avatar_employee"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="healthcare_unit_view_search" model="ir.ui.view">
        <field name="name">healthcare.hr.unit.search</field>
        <field name="model">healthcare.hr.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <group>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'unit_type'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_healthcare_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">healthcare.hr.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
