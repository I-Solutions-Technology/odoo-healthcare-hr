<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_department_view_form_healthcare" model="ir.ui.view">
        <field name="name">hr.department.form.healthcare</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="healthcare_branch_id"/>
                <field name="healthcare_department_type"/>
            </xpath>
        </field>
    </record>
    <record id="hr_department_view_list_healthcare" model="ir.ui.view">
        <field name="name">hr.department.list.healthcare</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="healthcare_branch_id" optional="show"/>
                <field name="healthcare_department_type" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="action_healthcare_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
