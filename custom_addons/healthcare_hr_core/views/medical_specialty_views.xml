<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="medical_specialty_view_list" model="ir.ui.view">
        <field name="name">healthcare.medical.specialty.list</field>
        <field name="model">healthcare.medical.specialty</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="complete_name" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_medical_specialty" model="ir.actions.act_window">
        <field name="name">Medical Specialties</field>
        <field name="res_model">healthcare.medical.specialty</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
