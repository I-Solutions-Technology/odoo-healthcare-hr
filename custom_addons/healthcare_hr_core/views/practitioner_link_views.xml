<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="practitioner_link_view_list" model="ir.ui.view">
        <field name="name">healthcare.employee.practitioner.link.list</field>
        <field name="model">healthcare.employee.practitioner.link</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="external_system"/>
                <field name="external_code"/>
                <field name="practitioner_model" optional="hide"/>
                <field name="practitioner_id" optional="hide"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_practitioner_link" model="ir.actions.act_window">
        <field name="name">Practitioner Links</field>
        <field name="res_model">healthcare.employee.practitioner.link</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
