<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_credential_company" model="ir.rule">
        <field name="name">Credential: multi-company</field>
        <field name="model_id" ref="model_healthcare_hr_credential"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_credential_self" model="ir.rule">
        <field name="name">Credential: own credentials</field>
        <field name="model_id" ref="model_healthcare_hr_credential"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_self_service'))]"/>
    </record>
    <record id="rule_credential_user" model="ir.rule">
        <field name="name">Credential: healthcare users - own, managed departments, non confidential in allowed branches</field>
        <field name="model_id" ref="model_healthcare_hr_credential"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id),
            '&amp;', ('confidential', '=', False),
            '|', ('department_id.manager_id.user_id', '=', user.id),
            ('branch_id', 'child_of', user.healthcare_branch_ids.ids) if user.healthcare_branch_ids else (1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_user'))]"/>
    </record>
    <record id="rule_credential_officer" model="ir.rule">
        <field name="name">Credential: officer allowed branches</field>
        <field name="model_id" ref="model_healthcare_hr_credential"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_officer'))]"/>
    </record>
</data>
</odoo>
