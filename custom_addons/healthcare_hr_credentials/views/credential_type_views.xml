<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credential_type_view_list" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.type.list</field>
        <field name="model">healthcare.hr.credential.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="credential_category"/>
                <field name="mandatory"/>
                <field name="clinical_only"/>
                <field name="blocks_shift_assignment"/>
                <field name="default_alert_days"/>
                <field name="confidential" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="credential_type_view_form" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.type.form</field>
        <field name="model">healthcare.hr.credential.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. ACLS"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="credential_category"/>
                            <field name="has_expiry"/>
                            <field name="default_alert_days" invisible="not has_expiry"/>
                            <field name="confidential"/>
                        </group>
                        <group string="Requirement">
                            <field name="mandatory"/>
                            <field name="clinical_only"/>
                            <field name="job_ids" widget="many2many_tags"/>
                            <field name="blocks_shift_assignment"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_credential_type" model="ir.actions.act_window">
        <field name="name">Credential Types</field>
        <field name="res_model">healthcare.hr.credential.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
