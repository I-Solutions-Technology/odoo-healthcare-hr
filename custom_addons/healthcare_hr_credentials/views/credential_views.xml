<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="credential_view_list" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.list</field>
        <field name="model">healthcare.hr.credential</field>
        <field name="arch" type="xml">
            <list decoration-danger="status in ('expired', 'missing')" decoration-warning="status == 'expiring'"
                  decoration-info="status == 'under_verification'">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="credential_type_id"/>
                <field name="credential_number" optional="show"/>
                <field name="issuing_authority" optional="hide"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="branch_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="verified" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring'" decoration-danger="status in ('expired', 'missing')"
                       decoration-info="status == 'under_verification'"/>
            </list>
        </field>
    </record>
    <record id="credential_view_form" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.form</field>
        <field name="model">healthcare.hr.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary" invisible="verified"
                            groups="healthcare_hr_core.group_hc_officer"/>
                    <button name="action_reset_verification" type="object" string="Reset Verification" invisible="not verified"
                            groups="healthcare_hr_core.group_hc_officer"/>
                    <field name="status" widget="statusbar" statusbar_visible="missing,under_verification,valid,expiring,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="status != 'expired'"/>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not verified or status == 'expired'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="credential_type_id"/>
                            <field name="credential_number"/>
                            <field name="issuing_authority"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" invisible="not expiry_date"/>
                            <field name="verified" readonly="1"/>
                            <field name="verified_by" invisible="not verified"/>
                            <field name="verification_date" invisible="not verified"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="credential_view_search" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.search</field>
        <field name="model">healthcare.hr.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="credential_type_id"/>
                <field name="credential_number"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <filter name="valid" string="Valid" domain="[('status', '=', 'valid')]"/>
                <filter name="expiring" string="Expiring" domain="[('status', '=', 'expiring')]"/>
                <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="missing" string="Missing" domain="[('status', '=', 'missing')]"/>
                <filter name="to_verify" string="Under Verification" domain="[('status', '=', 'under_verification')]"/>
                <separator/>
                <filter name="licenses" string="Licenses" domain="[('credential_category', 'in', ('license', 'registration'))]"/>
                <filter name="certifications" string="Certifications" domain="[('credential_category', '=', 'certification')]"/>
                <separator/>
                <filter name="expiry_date" string="Expiry Date" date="expiry_date"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'credential_type_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_category" string="Employee Category" context="{'group_by': 'employee_category'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="credential_view_pivot" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.pivot</field>
        <field name="model">healthcare.hr.credential</field>
        <field name="arch" type="xml">
            <pivot string="Credential Compliance" sample="1">
                <field name="credential_type_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="credential_view_graph" model="ir.ui.view">
        <field name="name">healthcare.hr.credential.graph</field>
        <field name="model">healthcare.hr.credential</field>
        <field name="arch" type="xml">
            <graph string="Credentials" type="bar" stacked="1" sample="1">
                <field name="credential_type_id"/>
                <field name="status"/>
            </graph>
        </field>
    </record>
    <record id="action_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">healthcare.hr.credential</field>
        <field name="view_mode">list,form,pivot,graph</field>
    </record>
    <record id="action_credential_attention" model="ir.actions.act_window">
        <field name="name">Needs Attention</field>
        <field name="res_model">healthcare.hr.credential</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="domain">[('status', 'in', ('expiring', 'expired', 'missing', 'under_verification'))]</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
    <record id="action_license_expiry_report" model="ir.actions.act_window">
        <field name="name">License Expiry</field>
        <field name="res_model">healthcare.hr.credential</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('credential_category', 'in', ('license', 'registration'))]</field>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>
    <record id="action_credential_compliance_report" model="ir.actions.act_window">
        <field name="name">Credential Compliance</field>
        <field name="res_model">healthcare.hr.credential</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
    <record id="action_generate_missing_credentials" model="ir.actions.server">
        <field name="name">Generate missing mandatory credentials</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="group_ids" eval="[(4, ref('healthcare_hr_core.group_hc_officer'))]"/>
        <field name="state">code</field>
        <field name="code">env['healthcare.hr.credential']._generate_missing_credentials(records)</field>
    </record>
</odoo>
