<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_loan_company" model="ir.rule">
        <field name="name">Loan: multi-company</field>
        <field name="model_id" ref="model_healthcare_hr_loan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_loan_self" model="ir.rule">
        <field name="name">Loan: own requests (draft/submitted editable)</field>
        <field name="model_id" ref="model_healthcare_hr_loan"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_self_service'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_loan_self_write" model="ir.rule">
        <field name="name">Loan: employee edits own draft request</field>
        <field name="model_id" ref="model_healthcare_hr_loan"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id), ('state', 'in', ('draft', 'submitted'))]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_self_service'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_loan_officer" model="ir.rule">
        <field name="name">Loan: payroll officer allowed branches</field>
        <field name="model_id" ref="model_healthcare_hr_loan"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_payroll_officer'))]"/>
    </record>
    <record id="rule_loan_installment_company" model="ir.rule">
        <field name="name">Loan installment: multi-company</field>
        <field name="model_id" ref="model_healthcare_hr_loan_installment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_loan_installment_self" model="ir.rule">
        <field name="name">Loan installment: own</field>
        <field name="model_id" ref="model_healthcare_hr_loan_installment"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_self_service'))]"/>
    </record>
    <record id="rule_loan_installment_officer" model="ir.rule">
        <field name="name">Loan installment: payroll officer</field>
        <field name="model_id" ref="model_healthcare_hr_loan_installment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_payroll_officer'))]"/>
    </record>
</data>
</odoo>
