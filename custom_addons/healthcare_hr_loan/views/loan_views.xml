<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loan_view_list" model="ir.ui.view">
        <field name="name">healthcare.hr.loan.list</field>
        <field name="model">healthcare.hr.loan</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('refused', 'cancelled')" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="loan_type"/>
                <field name="request_date"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="requested_amount" optional="show"/>
                <field name="approved_amount" sum="Approved"/>
                <field name="installment_count" optional="show"/>
                <field name="installment_amount" optional="show"/>
                <field name="remaining_amount" sum="Remaining"/>
                <field name="department_id" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state in ('submitted', 'approved')"
                       decoration-warning="state == 'active'" decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>
    <record id="loan_view_form" model="ir.ui.view">
        <field name="name">healthcare.hr.loan.form</field>
        <field name="model">healthcare.hr.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"
                            groups="healthcare_hr_core.group_hc_payroll_manager"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" class="btn-primary" invisible="state != 'approved'"
                            groups="healthcare_hr_core.group_hc_payroll_officer"/>
                    <button name="action_settle" type="object" string="Early Settlement" invisible="state != 'active'"
                            groups="healthcare_hr_core.group_hc_payroll_manager"
                            confirm="Mark every pending installment as settled outside payroll?"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="state not in ('submitted', 'approved')"
                            groups="healthcare_hr_core.group_hc_payroll_officer"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('refused', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="loan_type" readonly="state != 'draft'"/>
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="requested_amount" readonly="state != 'draft'"/>
                            <field name="approved_amount" readonly="state != 'submitted'" groups="healthcare_hr_core.group_hc_payroll_officer"/>
                            <field name="installment_count" readonly="state not in ('draft', 'submitted')"/>
                            <field name="first_deduction_date" readonly="state not in ('draft', 'submitted')"/>
                        </group>
                        <group>
                            <field name="installment_amount"/>
                            <field name="paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                            <field name="payment_date"/>
                            <field name="payment_reference" groups="healthcare_hr_core.group_hc_payroll_officer"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments" name="installments">
                            <field name="installment_ids" readonly="1">
                                <list decoration-success="state == 'paid'" decoration-warning="state == 'included'">
                                    <field name="sequence"/>
                                    <field name="due_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state"/>
                                    <field name="settled"/>
                                    <field name="payroll_input_id" optional="hide"/>
                                    <button name="action_postpone" type="object" string="Postpone" icon="fa-forward"
                                            invisible="state != 'pending'" groups="healthcare_hr_core.group_hc_payroll_officer"/>
                                </list>
                            </field>
                        </page>
                        <page string="Reason" name="reason">
                            <field name="reason" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="loan_view_search" model="ir.ui.view">
        <field name="name">healthcare.hr.loan.search</field>
        <field name="model">healthcare.hr.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <filter name="my" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="running" string="Running" domain="[('state', 'in', ('approved', 'active'))]"/>
                <separator/>
                <filter name="loans" string="Loans" domain="[('loan_type', '=', 'loan')]"/>
                <filter name="advances" string="Salary Advances" domain="[('loan_type', '=', 'advance')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_loan" model="ir.actions.act_window">
        <field name="name">Loans &amp; Advances</field>
        <field name="res_model">healthcare.hr.loan</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_my_loans" model="ir.actions.act_window">
        <field name="name">My Loan Requests</field>
        <field name="res_model">healthcare.hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my': 1}</field>
    </record>
</odoo>
