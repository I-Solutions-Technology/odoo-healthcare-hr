<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_payroll_input_company" model="ir.rule">
        <field name="name">Payroll input: multi-company</field>
        <field name="model_id" ref="model_healthcare_payroll_input"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_payroll_input_branch" model="ir.rule">
        <field name="name">Payroll input: payroll officer allowed branches</field>
        <field name="model_id" ref="model_healthcare_payroll_input"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_payroll_officer'))]"/>
    </record>
    <record id="rule_payroll_input_all" model="ir.rule">
        <field name="name">Payroll input: payroll manager all branches</field>
        <field name="model_id" ref="model_healthcare_payroll_input"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_payroll_manager'))]"/>
    </record>
</data>
</odoo>
