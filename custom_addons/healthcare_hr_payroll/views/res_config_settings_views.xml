<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_payroll" model="ir.ui.view">
        <field name="name">res.config.settings.form.healthcare.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="healthcare_hr_core.res_config_settings_view_form_healthcare"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='hc_alerts']" position="before">
                <block title="Payroll" name="hc_payroll">
                    <setting string="Overtime rate" help="Multiplier applied to the hourly wage">
                        <field name="hc_overtime_rate"/>
                    </setting>
                    <setting string="Monthly hours" help="Hourly rate = wage / monthly hours. Empty = from the working schedule">
                        <field name="hc_payroll_monthly_hours"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
