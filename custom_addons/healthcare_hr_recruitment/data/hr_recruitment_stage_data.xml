<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stage_credential_verification" model="hr.recruitment.stage">
        <field name="name">Credential Verification</field>
        <field name="sequence">5</field>
        <field name="hc_credential_verification" eval="True"/>
        <field name="legend_normal">In Progress</field>
        <field name="legend_waiting">Waiting</field>
        <field name="legend_blocked">Blocked</field>
        <field name="legend_done">Ready for Next Stage</field>
        <field name="requirements">Verify the professional license, classification and mandatory certifications (BLS ...) with the issuing authority. Hiring is blocked until the credential verification status is "Verified".</field>
    </record>
    <!-- Offer (Contract Proposal) -> Credential Verification -> hired stage(s) -->
    <function model="hr.recruitment.stage" name="_hc_place_credential_stage"/>
</odoo>
