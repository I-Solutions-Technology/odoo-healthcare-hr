<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="rule_applicant_credential_company" model="ir.rule">
        <field name="name">Applicant credential: multi-company</field>
        <field name="model_id" ref="model_healthcare_applicant_credential"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_applicant_credential_interviewer" model="ir.rule">
        <field name="name">Applicant credential: interviewers of the applicant</field>
        <field name="model_id" ref="model_healthcare_applicant_credential"/>
        <field name="domain_force">['|', ('applicant_id.job_id.interviewer_ids', 'in', user.id), ('applicant_id.interviewer_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
    </record>
    <record id="rule_applicant_credential_user" model="ir.rule">
        <field name="name">Applicant credential: recruitment officers</field>
        <field name="model_id" ref="model_healthcare_applicant_credential"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
    </record>
</data>
</odoo>
