<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_shift" model="ir.ui.view">
        <field name="name">hr.employee.form.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="healthcare_hr_core.hr_employee_view_form_healthcare"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='hc_organisation']" position="after">
                <group string="Scheduling" name="hc_scheduling" groups="hr.group_hr_user">
                    <field name="weekend_work_allowed"/>
                    <field name="allow_24h_shift"/>
                    <field name="max_weekly_hours"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="hr_employee_view_form_shift_button" model="ir.ui.view">
        <field name="name">hr.employee.form.shift.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shifts" type="object" class="oe_stat_button" icon="fa-calendar"
                        string="Shifts" groups="healthcare_hr_core.group_hc_user"/>
            </xpath>
        </field>
    </record>
</odoo>
