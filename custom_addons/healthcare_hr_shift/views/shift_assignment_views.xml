<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shift_assignment_view_list" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.list</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <list multi_edit="1" decoration-danger="state == 'conflict'" decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'" decoration-success="state in ('approved', 'payroll_posted')">
                <header>
                    <button name="action_publish" type="object" string="Publish" groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <button name="action_check" type="object" string="Check Conflicts" groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                </header>
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="shift_template_id"/>
                <field name="datetime_start" optional="show"/>
                <field name="datetime_end" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="unit_id" optional="hide"/>
                <field name="employee_category" optional="hide"/>
                <field name="planned_hours" sum="Planned" widget="float_time"/>
                <field name="actual_worked_hours" sum="Worked" widget="float_time" optional="show"/>
                <field name="extra_hours" optional="hide" widget="float_time"/>
                <field name="overtime_hours" optional="show" widget="float_time"/>
                <field name="night_hours" optional="hide" widget="float_time"/>
                <field name="weekend_hours" optional="hide" widget="float_time"/>
                <field name="holiday_hours" optional="hide" widget="float_time"/>
                <field name="conflict_reason" optional="show"/>
                <field name="state" widget="badge" decoration-danger="state == 'conflict'" decoration-info="state in ('published', 'confirmed')"
                       decoration-warning="state == 'working'" decoration-success="state in ('completed', 'approved', 'payroll_posted')"/>
            </list>
        </field>
    </record>
    <record id="shift_assignment_view_form" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.form</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state not in ('draft', 'conflict')" groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <button name="action_check" type="object" string="Check Conflicts"
                            invisible="state not in ('draft', 'conflict')" groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <button name="action_force_publish" type="object" string="Publish Anyway"
                            invisible="state != 'conflict'" groups="healthcare_hr_core.group_hc_scheduling_manager"
                            confirm="Publish this shift despite the conflicts? The override reason is logged."/>
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'published'"/>
                    <button name="action_approve" type="object" string="Approve Work" invisible="state not in ('completed', 'working')"
                            groups="healthcare_hr_core.group_hc_attendance_officer"/>
                    <button name="action_reset_approval" type="object" string="Reset Approval" invisible="state != 'approved'"
                            groups="healthcare_hr_core.group_hc_attendance_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('conflict', 'cancelled', 'published', 'confirmed')"
                            groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('cancelled', 'approved', 'payroll_posted')"
                            groups="healthcare_hr_core.group_hc_scheduling_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,working,completed,approved,payroll_posted"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not conflict_reason">
                        <field name="conflict_reason" nolabel="1"/>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Shift">
                            <field name="employee_id" readonly="state not in ('draft', 'conflict')"/>
                            <field name="shift_template_id" readonly="state not in ('draft', 'conflict')"/>
                            <field name="date" readonly="state not in ('draft', 'conflict')"/>
                            <field name="datetime_start" readonly="state not in ('draft', 'conflict')"/>
                            <field name="datetime_end" readonly="state not in ('draft', 'conflict')"/>
                            <field name="planned_hours" widget="float_time"/>
                            <field name="override_reason" invisible="state != 'conflict'"
                                   groups="healthcare_hr_core.group_hc_scheduling_manager"/>
                        </group>
                        <group string="Organisation">
                            <field name="branch_id"/>
                            <field name="department_id"/>
                            <field name="unit_id"/>
                            <field name="job_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="planning_slot_id" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group>
                        <group string="Actual">
                            <field name="actual_check_in"/>
                            <field name="actual_check_out"/>
                            <field name="actual_worked_hours" widget="float_time"/>
                            <field name="extra_hours" widget="float_time"/>
                            <field name="overtime_hours" widget="float_time" readonly="state in ('approved', 'payroll_posted')"/>
                            <field name="payroll_overtime_hours" widget="float_time"/>
                        </group>
                        <group string="Premium Hours">
                            <field name="night_hours" widget="float_time"/>
                            <field name="weekend_hours" widget="float_time"/>
                            <field name="holiday_hours" widget="float_time"/>
                            <field name="payroll_processed"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="shift_assignment_view_calendar" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.calendar</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Shifts" date_start="datetime_start" date_stop="datetime_end" color="shift_template_id"
                      mode="week" quick_create="0" event_open_popup="1">
                <field name="employee_id" filters="1" avatar_field="avatar_128"/>
                <field name="shift_template_id" filters="1"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="shift_assignment_view_gantt" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.gantt</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <gantt date_start="datetime_start" date_stop="datetime_end" default_group_by="employee_id"
                   default_scale="week" color="color" string="Roster" decoration-danger="state == 'conflict'"
                   decoration-info="state == 'draft'">
                <field name="state"/>
                <field name="shift_template_id"/>
            </gantt>
        </field>
    </record>
    <record id="shift_assignment_view_pivot" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.pivot</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Shift Analysis" sample="1">
                <field name="department_id" type="row"/>
                <field name="shift_template_id" type="col"/>
                <field name="planned_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="shift_assignment_view_graph" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.graph</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <graph string="Shifts" type="bar" sample="1">
                <field name="date" interval="day"/>
                <field name="planned_hours" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="shift_assignment_view_search" model="ir.ui.view">
        <field name="name">healthcare.shift.assignment.search</field>
        <field name="model">healthcare.shift.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="unit_id"/>
                <field name="job_id"/>
                <field name="shift_template_id"/>
                <filter name="my_shifts" string="My Shifts" domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="Next 7 Days"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Date" date="date"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="conflict" string="Conflict" domain="[('state', '=', 'conflict')]"/>
                <filter name="published" string="Published" domain="[('state', 'in', ('published', 'confirmed'))]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', 'in', ('working', 'completed'))]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'payroll_posted'))]"/>
                <separator/>
                <filter name="night" string="Night Shifts" domain="[('night_hours', '&gt;', 0)]"/>
                <filter name="weekend" string="Weekend Shifts" domain="[('weekend_hours', '&gt;', 0)]"/>
                <filter name="with_overtime" string="With Overtime" domain="[('overtime_hours', '&gt;', 0)]"/>
                <separator/>
                <filter name="cat_doctor" string="Doctors" domain="[('employee_category', 'in', ('doctor', 'radiology_doctor'))]"/>
                <filter name="cat_nurse" string="Nurses" domain="[('employee_category', '=', 'nurse')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'employee_category'}"/>
                    <filter name="group_template" string="Shift" context="{'group_by': 'shift_template_id'}"/>
                    <filter name="group_type" string="Shift Type" context="{'group_by': 'shift_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_shift_assignment" model="ir.actions.act_window">
        <field name="name">Shift Assignments</field>
        <field name="res_model">healthcare.shift.assignment</field>
        <field name="view_mode">calendar,gantt,list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan the first shifts of your roster</p>
            <p>Use "Generate Shifts" to create a roster, then "Publish Roster" to validate and publish it.</p>
        </field>
    </record>
    <record id="action_my_shifts" model="ir.actions.act_window">
        <field name="name">My Shifts</field>
        <field name="res_model">healthcare.shift.assignment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_my_shifts': 1}</field>
    </record>
    <record id="action_shift_report_night" model="ir.actions.act_window">
        <field name="name">Night Shifts</field>
        <field name="res_model">healthcare.shift.assignment</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_night': 1, 'search_default_approved': 1, 'pivot_measures': ['night_hours', '__count']}</field>
    </record>
    <record id="action_shift_report_weekend" model="ir.actions.act_window">
        <field name="name">Weekend Shifts</field>
        <field name="res_model">healthcare.shift.assignment</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_weekend': 1, 'pivot_measures': ['weekend_hours', '__count']}</field>
    </record>
    <record id="action_shift_report_overtime" model="ir.actions.act_window">
        <field name="name">Overtime</field>
        <field name="res_model">healthcare.shift.assignment</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'search_default_with_overtime': 1, 'pivot_measures': ['extra_hours', 'overtime_hours', 'payroll_overtime_hours']}</field>
    </record>
</odoo>
