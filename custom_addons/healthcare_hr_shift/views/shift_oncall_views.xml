<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shift_oncall_view_list" model="ir.ui.view">
        <field name="name">healthcare.shift.oncall.list</field>
        <field name="model">healthcare.shift.oncall</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-warning="called_in">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="branch_id" optional="show"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="standby_hours" sum="Standby" widget="float_time"/>
                <field name="called_in"/>
                <field name="worked_hours" sum="Worked" widget="float_time"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="allowance_amount" sum="Allowance" groups="healthcare_hr_core.group_hc_payroll_officer"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'scheduled'"/>
            </list>
        </field>
    </record>
    <record id="shift_oncall_view_form" model="ir.ui.view">
        <field name="name">healthcare.shift.oncall.form</field>
        <field name="model">healthcare.shift.oncall</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'done'"
                            groups="healthcare_hr_core.group_hc_attendance_officer,healthcare_hr_core.group_hc_department_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('approved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,done,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="branch_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                        <group>
                            <field name="called_in"/>
                            <field name="actual_call_datetime" invisible="not called_in" required="called_in and state == 'done'"/>
                            <field name="call_end_datetime" invisible="not called_in"/>
                            <field name="standby_hours" widget="float_time"/>
                            <field name="worked_hours" widget="float_time"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="allowance_amount" groups="healthcare_hr_core.group_hc_payroll_officer"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="shift_oncall_view_calendar" model="ir.ui.view">
        <field name="name">healthcare.shift.oncall.calendar</field>
        <field name="model">healthcare.shift.oncall</field>
        <field name="arch" type="xml">
            <calendar date_start="start_datetime" date_stop="end_datetime" color="employee_id" mode="month" quick_create="0">
                <field name="employee_id" filters="1"/>
                <field name="called_in"/>
            </calendar>
        </field>
    </record>
    <record id="action_shift_oncall" model="ir.actions.act_window">
        <field name="name">On-Call</field>
        <field name="res_model">healthcare.shift.oncall</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
