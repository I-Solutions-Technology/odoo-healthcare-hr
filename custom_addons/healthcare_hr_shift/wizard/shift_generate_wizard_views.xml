<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shift_generate_wizard_view_form" model="ir.ui.view">
        <field name="name">healthcare.shift.generate.wizard.form</field>
        <field name="model">healthcare.shift.generate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="shift_template_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Weekdays">
                        <field name="monday"/>
                        <field name="tuesday"/>
                        <field name="wednesday"/>
                        <field name="thursday"/>
                        <field name="friday"/>
                        <field name="saturday"/>
                        <field name="sunday"/>
                    </group>
                </group>
                <field name="employee_ids" widget="many2many_tags_avatar"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate Draft Shifts" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_shift_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Shifts</field>
        <field name="res_model">healthcare.shift.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
