<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <!-- Multi-company -->
    <record id="rule_training_requirement_company" model="ir.rule">
        <field name="name">Training requirement: multi-company</field>
        <field name="model_id" ref="model_healthcare_training_requirement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_training_assignment_company" model="ir.rule">
        <field name="name">Training assignment: multi-company</field>
        <field name="model_id" ref="model_healthcare_training_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_training_compliance_company" model="ir.rule">
        <field name="name">Training compliance: multi-company</field>
        <field name="model_id" ref="model_healthcare_training_compliance_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Assignments: own / managed departments / allowed branches / all -->
    <record id="rule_training_assignment_self" model="ir.rule">
        <field name="name">Training assignment: own</field>
        <field name="model_id" ref="model_healthcare_training_assignment"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_self_service'))]"/>
    </record>
    <record id="rule_training_assignment_dept_manager" model="ir.rule">
        <field name="name">Training assignment: managed departments</field>
        <field name="model_id" ref="model_healthcare_training_assignment"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_department_manager'))]"/>
    </record>
    <record id="rule_training_assignment_user" model="ir.rule">
        <field name="name">Training assignment: allowed branches</field>
        <field name="model_id" ref="model_healthcare_training_assignment"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_user'))]"/>
    </record>
    <record id="rule_training_assignment_all" model="ir.rule">
        <field name="name">Training assignment: all branches</field>
        <field name="model_id" ref="model_healthcare_training_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_manager')), (4, ref('healthcare_hr_core.group_hc_director'))]"/>
    </record>

    <!-- Compliance analysis -->
    <record id="rule_training_compliance_user" model="ir.rule">
        <field name="name">Training compliance: allowed branches</field>
        <field name="model_id" ref="model_healthcare_training_compliance_report"/>
        <field name="domain_force">['|', ('branch_id', '=', False), ('branch_id', 'child_of', user.healthcare_branch_ids.ids)] if user.healthcare_branch_ids else [(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_user'))]"/>
    </record>
    <record id="rule_training_compliance_all" model="ir.rule">
        <field name="name">Training compliance: all branches</field>
        <field name="model_id" ref="model_healthcare_training_compliance_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('healthcare_hr_core.group_hc_manager')), (4, ref('healthcare_hr_core.group_hc_director'))]"/>
    </record>
</data>
</odoo>
