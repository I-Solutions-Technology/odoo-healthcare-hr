<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="training_compliance_report_view_list" model="ir.ui.view">
        <field name="name">healthcare.training.compliance.report.list</field>
        <field name="model">healthcare.training.compliance.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="status == 'missing'"
                  decoration-warning="status in ('expiring', 'in_training')">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="requirement_id"/>
                <field name="credential_type_id"/>
                <field name="department_id"/>
                <field name="branch_id" optional="show"/>
                <field name="job_id" optional="hide"/>
                <field name="mandatory" optional="hide"/>
                <field name="covered_until"/>
                <field name="due_date" optional="show"/>
                <field name="status" widget="badge" decoration-success="status in ('compliant', 'waived')"
                       decoration-warning="status in ('expiring', 'in_training')" decoration-danger="status == 'missing'"/>
            </list>
        </field>
    </record>
    <record id="training_compliance_report_view_search" model="ir.ui.view">
        <field name="name">healthcare.training.compliance.report.search</field>
        <field name="model">healthcare.training.compliance.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="requirement_id"/>
                <field name="credential_type_id"/>
                <field name="department_id"/>
                <field name="branch_id"/>
                <filter name="non_compliant" string="Not Compliant" domain="[('compliant', '=', False)]"/>
                <filter name="expiring" string="Expiring" domain="[('status', '=', 'expiring')]"/>
                <separator/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_requirement" string="Requirement" context="{'group_by': 'requirement_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="training_compliance_report_view_pivot" model="ir.ui.view">
        <field name="name">healthcare.training.compliance.report.pivot</field>
        <field name="model">healthcare.training.compliance.report</field>
        <field name="arch" type="xml">
            <pivot string="Training Compliance" disable_linking="1">
                <field name="department_id" type="row"/>
                <field name="requirement_id" type="col"/>
                <field name="compliance_rate" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="training_compliance_report_view_graph" model="ir.ui.view">
        <field name="name">healthcare.training.compliance.report.graph</field>
        <field name="model">healthcare.training.compliance.report</field>
        <field name="arch" type="xml">
            <graph string="Training Compliance" type="bar">
                <field name="department_id"/>
                <field name="compliance_rate" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_training_compliance_report" model="ir.actions.act_window">
        <field name="name">Training Compliance</field>
        <field name="res_model">healthcare.training.compliance.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_mandatory': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No training requirement in scope</p>
            <p>Compliance rate by department = share of (employee, mandatory requirement) pairs covered by a
               valid credential, a completed training or a waiver.</p>
        </field>
    </record>
    <record id="action_missing_training_report" model="ir.actions.act_window">
        <field name="name">Missing Training</field>
        <field name="res_model">healthcare.training.compliance.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('status', 'in', ('missing', 'in_training'))]</field>
        <field name="context">{'search_default_mandatory': 1, 'search_default_group_requirement': 1}</field>
    </record>
    <record id="action_expiring_certification_report" model="ir.actions.act_window">
        <field name="name">Expiring Certifications</field>
        <field name="res_model">healthcare.hr.credential</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('credential_type_id.training_requirement_ids', '!=', False), ('expiry_date', '!=', False)]</field>
        <field name="context">{'search_default_expiring': 1, 'search_default_expired': 1, 'search_default_group_type': 1}</field>
    </record>
</odoo>
