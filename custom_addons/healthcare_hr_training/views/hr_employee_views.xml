<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_training" model="ir.ui.view">
        <field name="name">hr.employee.form.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_training" type="object" class="oe_stat_button" icon="fa-graduation-cap"
                        groups="hr.group_hr_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="training_open_count"/></span>
                        <span class="o_stat_text">Open Trainings</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
