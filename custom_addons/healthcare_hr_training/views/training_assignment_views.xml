<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="training_assignment_view_list" model="ir.ui.view">
        <field name="name">healthcare.training.assignment.list</field>
        <field name="model">healthcare.training.assignment</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue or state == 'expired'" decoration-muted="state == 'waived'"
                  decoration-success="state == 'completed'">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="requirement_id"/>
                <field name="credential_type_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="branch_id" optional="hide"/>
                <field name="due_date"/>
                <field name="completion_date" optional="show"/>
                <field name="expiry_date" optional="show"/>
                <field name="score" optional="hide"/>
                <field name="mandatory" optional="hide"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="compliant" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state in ('assigned', 'in_progress')"
                       decoration-success="state == 'completed'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>
    <record id="training_assignment_view_form" model="ir.ui.view">
        <field name="name">healthcare.training.assignment.form</field>
        <field name="model">healthcare.training.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'assigned'"
                            groups="healthcare_hr_core.group_hc_training_officer"/>
                    <button name="action_complete" type="object" string="Mark Completed" class="btn-primary"
                            invisible="state not in ('assigned', 'in_progress')"
                            groups="healthcare_hr_core.group_hc_training_officer"/>
                    <button name="action_waive" type="object" string="Waive" invisible="state not in ('assigned', 'in_progress')"
                            groups="healthcare_hr_core.group_hc_training_officer"
                            confirm="Waive this training? Enter the reason in the Waiver Reason field first."/>
                    <button name="action_reset" type="object" string="Cancel Waiver" invisible="state != 'waived'"
                            groups="healthcare_hr_core.group_hc_training_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,in_progress,completed,expired"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Compliant" bg_color="text-bg-success" invisible="not compliant"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state not in ('assigned', 'in_progress')"/>
                            <field name="requirement_id" readonly="state not in ('assigned', 'in_progress')"/>
                            <field name="credential_type_id"/>
                            <field name="mandatory"/>
                            <field name="department_id"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="assigned_date"/>
                            <field name="due_date"/>
                            <field name="completion_date" readonly="state not in ('assigned', 'in_progress')"/>
                            <field name="expiry_date"/>
                            <field name="is_overdue" invisible="1"/>
                            <field name="compliant" invisible="1"/>
                            <field name="waiver_reason" invisible="state not in ('assigned', 'in_progress', 'waived')"
                                   readonly="state == 'waived'"/>
                        </group>
                    </group>
                    <group string="Result">
                        <group>
                            <field name="provider" readonly="state not in ('assigned', 'in_progress')"/>
                            <field name="certificate_number" readonly="state not in ('assigned', 'in_progress')"/>
                            <field name="score" readonly="state not in ('assigned', 'in_progress')"/>
                        </group>
                        <group>
                            <field name="credential_id"/>
                            <field name="credential_status" invisible="not credential_id" widget="badge"/>
                        </group>
                    </group>
                    <group string="Certificate">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"
                               readonly="state not in ('assigned', 'in_progress')"/>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="training_assignment_view_search" model="ir.ui.view">
        <field name="name">healthcare.training.assignment.search</field>
        <field name="model">healthcare.training.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="requirement_id"/>
                <field name="credential_type_id"/>
                <field name="department_id"/>
                <field name="branch_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('assigned', 'in_progress'))]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', 'in', ('assigned', 'in_progress')), ('due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <filter name="non_compliant" string="Not Compliant" domain="[('compliant', '=', False)]"/>
                <separator/>
                <filter name="due_date" string="Due Date" date="due_date"/>
                <filter name="expiry_date" string="Expiry Date" date="expiry_date"/>
                <group>
                    <filter name="group_requirement" string="Requirement" context="{'group_by': 'requirement_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="training_assignment_view_pivot" model="ir.ui.view">
        <field name="name">healthcare.training.assignment.pivot</field>
        <field name="model">healthcare.training.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Training Assignments" sample="1">
                <field name="requirement_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="training_assignment_view_graph" model="ir.ui.view">
        <field name="name">healthcare.training.assignment.graph</field>
        <field name="model">healthcare.training.assignment</field>
        <field name="arch" type="xml">
            <graph string="Training Assignments" type="bar" stacked="1" sample="1">
                <field name="requirement_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <record id="action_training_assignment" model="ir.actions.act_window">
        <field name="name">Training Assignments</field>
        <field name="res_model">healthcare.training.assignment</field>
        <field name="view_mode">list,form,pivot,graph,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No training assignment yet</p>
            <p>Assignments are generated daily from the Training Requirement Matrix.</p>
        </field>
    </record>
    <record id="action_my_training" model="ir.actions.act_window">
        <field name="name">My Training</field>
        <field name="res_model">healthcare.training.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
